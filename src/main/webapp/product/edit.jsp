<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Sửa sản phẩm</title></head><body><h2>Sửa sản phẩm</h2><form action="${pageContext.request.contextPath}/products?action=edit" method="post"><input type="hidden" name="id" value="${product.id}"><label>Tên: <input name="name" value="${product.name}" required></label><br><label>Giá: <input type="number" step="any" name="price" value="${product.price}" required></label><br><label>Mô tả: <input name="description" value="${product.description}" required></label><br><label>Nhà sản xuất: <input name="manufacturer" value="${product.manufacturer}" required></label><br><button>Cập nhật</button></form><a href="${pageContext.request.contextPath}/products">Quay lại</a></body></html>
