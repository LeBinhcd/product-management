<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Quản lý sản phẩm</title></head><body><h1>Danh sách sản phẩm</h1><form action="${pageContext.request.contextPath}/products" method="get"><input type="hidden" name="action" value="search"><input name="keyword" value="${keyword}" placeholder="Tìm theo tên"><button>Tìm kiếm</button></form><p><a href="${pageContext.request.contextPath}/products?action=create">Thêm sản phẩm</a></p><table border="1" cellpadding="8"><tr><th>ID</th><th>Tên</th><th>Giá</th><th>Mô tả</th><th>Nhà sản xuất</th><th>Hành động</th></tr><c:forEach items="${products}" var="product"><tr><td>${product.id}</td><td><a href="${pageContext.request.contextPath}/products?action=view&id=${product.id}">${product.name}</a></td><td>${product.price}</td><td>${product.description}</td><td>${product.manufacturer}</td><td><a href="${pageContext.request.contextPath}/products?action=edit&id=${product.id}">Sửa</a> <a href="${pageContext.request.contextPath}/products?action=delete&id=${product.id}">Xóa</a></td></tr></c:forEach></table></body></html>
